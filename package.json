{
  "name": "mmart-promotion-dashboard",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "build:preview": "npm --workspace frontend run build:preview",
    "build:online": "npm run build",
    "test:online": "node scripts/check-browser.mjs",
    "preview": "npm --workspace frontend run preview",
    "lint": "prettier --check frontend/src frontend/vite.config.js tests/workspace-browser.mjs scripts/check-browser.mjs",
    "legacy:promotion:dev": "vite --config vite.config.js --host 127.0.0.1",
    "legacy:promotion:build": "vite build --config vite.config.js --outDir legacy-dist",
    "legacy:promotion:import": "node scripts/import-workbook.mjs",
    "test:backend": "cd backend && ../.venv/bin/python -m pytest tests -q",
    "test:browser": "node tests/workspace-browser.mjs && node tests/login-browser.mjs && node tests/bulk-delete-browser.mjs && node tests/source-import-browser.mjs && node tests/smart-dashboard-browser.mjs",
    "audit:dependencies": "npm audit"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^5.8.8",
    "recharts": "^3.0.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "vite": "^7.0.0"
  }
}
