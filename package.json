    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "vite": "^7.0.0"
  }
}
